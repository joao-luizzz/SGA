# SGA Environment Configuration Example
# Copy this file to .env for local deployment: cp .env.example .env

DEBUG=True
SECRET_KEY=django-insecure-sga-development-key-change-in-production-12345
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
DB_NAME=sga_db
DB_USER=sga_user
DB_PASSWORD=sga_password
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgres://sga_user:sga_password@db:5432/sga_db
